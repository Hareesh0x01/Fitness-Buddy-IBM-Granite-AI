# ============================================================
# Fitness Buddy Frontend — .gitignore
# ============================================================

# -- SECRETS (NEVER COMMIT) -----------------------------------
.env
.env.local
.env.development
.env.production
.env.staging
.env.test

# -- BUILD OUTPUT ---------------------------------------------
dist/
dist-ssr/
.vite/

# -- DEPENDENCIES ---------------------------------------------
node_modules/

# -- LOGS -----------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -- OS -------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# -- EDITOR ---------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# -- MISC -----------------------------------------------------
*.local
.cache/
.eslintcache
coverage/
