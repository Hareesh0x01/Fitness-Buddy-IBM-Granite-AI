# ============================================================
# Fitness Buddy Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to version control.
# ============================================================

# ---- Server Configuration ----
PORT=5000

# CORS origin — comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ---- IBM Granite / watsonx.ai Configuration (REQUIRED for AI features) ----
# Get these from IBM Cloud: https://cloud.ibm.com/
#
# IBM Cloud API Key (found in IAM > API Keys)
IBM_API_KEY=your_ibm_cloud_api_key_here
#
# watsonx.ai Project ID (found in your watsonx.ai project settings)
IBM_PROJECT_ID=your_watsonx_project_id_here
#
# IBM Granite model ID (default: ibm/granite-13b-chat-v2)
IBM_MODEL_ID=ibm/granite-13b-chat-v2
#
# watsonx.ai service URL (change region as needed)
# Options: https://us-south.ml.cloud.ibm.com
#          https://eu-gb.ml.cloud.ibm.com
#          https://au-syd.ml.cloud.ibm.com
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ============================================================
# NOTE: If IBM credentials are not provided, the app will
# automatically fall back to a mock AI provider that returns
# demo responses. This is for local development only.
# IBM Granite MUST be configured for production/demo.
# ============================================================
